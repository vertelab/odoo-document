<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        A `.md` file rendered as a document.

        Plain HTML with inline CSS: the page is a single reading view, and
        pulling in the backend asset bundle for it would load menus, Owl and
        the whole web client for a page that shows text.
    -->
    <template id="markdown_page" name="Markdown document">
        <html>
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title t-esc="file_name" />
                <style>
                    :root { color-scheme: light dark; }
                    body {
                        margin: 0;
                        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
                        line-height: 1.6;
                        color: #212529;
                        background: #fff;
                    }
                    .md-header {
                        position: sticky;
                        top: 0;
                        display: flex;
                        align-items: center;
                        gap: 0.75rem;
                        height: 2.25rem;
                        padding: 0 0.75rem;
                        font-size: 0.8125rem;
                        background: #f8f9fa;
                        border-bottom: 1px solid #dee2e6;
                    }
                    .md-header a { color: #1971c2; text-decoration: none; }
                    .md-header a:hover { text-decoration: underline; }
                    .md-header__name {
                        flex: 1;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                        font-weight: 500;
                        color: #212529;
                    }
                    .md-body {
                        max-width: 52rem;
                        margin: 2rem auto 4rem;
                        padding: 0 1.25rem;
                    }
                    .md-body h1, .md-body h2 { border-bottom: 1px solid #e9ecef; padding-bottom: 0.3em; }
                    .md-body h1 { font-size: 2rem; }
                    .md-body h2 { font-size: 1.5rem; margin-top: 2rem; }
                    .md-body h3 { font-size: 1.25rem; margin-top: 1.5rem; }
                    .md-body code {
                        background: #f1f3f5;
                        padding: 0.15em 0.35em;
                        border-radius: 0.25rem;
                        font-size: 0.9em;
                    }
                    .md-body pre {
                        background: #f1f3f5;
                        padding: 1rem;
                        border-radius: 0.375rem;
                        overflow-x: auto;
                    }
                    .md-body pre code { background: none; padding: 0; }
                    .md-body blockquote {
                        margin: 1rem 0;
                        padding-left: 1rem;
                        border-left: 4px solid #dee2e6;
                        color: #495057;
                    }
                    .md-body table {
                        border-collapse: collapse;
                        margin: 1rem 0;
                    }
                    .md-body th, .md-body td {
                        border: 1px solid #dee2e6;
                        padding: 0.4rem 0.75rem;
                        text-align: left;
                    }
                    .md-body img { max-width: 100%; height: auto; }
                </style>
            </head>
            <body>
                <div class="md-header">
                    <a t-att-href="back_url" title="Back to the file in Odoo">
                        &#8592; Back
                    </a>
                    <span class="md-header__name" t-esc="file_name" />
                </div>
                <div class="md-body" t-out="body" />
            </body>
        </html>
    </template>
</odoo>
