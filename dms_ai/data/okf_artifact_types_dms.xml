<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Artefakttyper för dokumentbryggan (okf-mixin D12).

             `bridge_module` pekar på dms_ai, så taxonomin kan spåras till
             EN brygga. Namnen är unika i ai.artifact.type (UNIQUE(name)). -->
        <record id="artifact_type_dms_file" model="ai.artifact.type">
            <field name="name">dms_file</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">dms_ai</field>
            <field name="model_id" ref="dms.model_dms_file"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
        <record id="artifact_type_dms_directory" model="ai.artifact.type">
            <field name="name">dms_directory</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">dms_ai</field>
            <field name="model_id" ref="dms.model_dms_directory"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
    </data>
</odoo>
