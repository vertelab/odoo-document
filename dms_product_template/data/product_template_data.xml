<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Access mode: inherit.
            save_type='attachment' + inherit_access_from_parent_record is what
            makes the directory inherit the record's own ir.rule. Both are
            required: dms.security.mixin hardcodes them.
        -->
        <record id="product_template_dms_storage" model="dms.storage">
            <field name="name">Product documents</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="save_type">attachment</field>
            <field name="inherit_access_from_parent_record">True</field>
            <field name="model_ids" eval="[(6, 0, [ref('product.model_product_template')])]"/>
        </record>

        <record id="product_template_dms_directory" model="dms.directory">
            <field name="name">Product documents</field>
            <field name="is_root_directory">True</field>
            <field name="storage_id" ref="product_template_dms_storage"/>
            <field name="model_id" ref="product.model_product_template"/>
        </record>

    </data>
</odoo>
