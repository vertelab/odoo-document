<odoo>
  <data>
    <record id="fleet_vehicle_doc_count" model="ir.ui.view">
      <field name="name">fleet.vehicle.doc_count</field>
      <field name="model">fleet.vehicle</field>
      <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
          <button class="oe_stat_button" name="action_open_dms_files"
                  type="object" icon="fa-file-text-o"
                  invisible="not dms_directory_id">
            <field string="Documents" name="doc_count" widget="statinfo"/>
          </button>
        </xpath>
        <field name="name" position="after">
          <field name="dms_directory_id" invisible="1"/>
        </field>
      </field>
    </record>
  </data>
</odoo>
