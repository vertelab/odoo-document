<odoo>

    <template id="portal_my_dms" name="View File" inherit_id="dms.portal_my_dms">
        <xpath expr="//t[@t-call='portal.portal_layout']/t[@t-if='dms_directories or dms_files']/tbody[1]/t[@t-if='dms_files']//t[@t-foreach='dms_files']/tr[1]/td[1]" position="replace">
            <td>
                <a t-attf-href="/my/dms/file/#{dms_file.id}" t-attf-class="tr_dms_file_link" t-att-title="dms_file.name">
                    <img class="o_portal_contact_img" t-att-src="dms_file.icon_url"/>
                    <span t-esc="dms_file.name" />
                </a>
            </td>
        </xpath>
    </template>

    <template id="portal_my_dms_file" name="My DMS File">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Projects</t>
            </t>

            <t t-set="card_body">
                <div itemprop="description" t-field="dms_file.web_content" class="oe_structure oe_empty mt16" id="web_content"/>
            </t>

            <div class="mt32 attachment_container">
                <div class="file_container">
                    <div class="file_details_container">                        
                         <div class="card shadow-sm border-0">
                            <div class="card-header d-flex justify-content-between align-items-center bg-white py-3">
                                <div class="d-flex align-items-center">
                                    <div t-attf-class="o_image_small me-2" t-att-data-mimetype="dms_file.mimetype"/>
                                    <h5 class="mb-0 text-900"><t t-esc="dms_file.name"/></h5>
                                </div>
                                <span class="badge rounded-pill text-bg-light border"><t t-esc="dms_file.mimetype"/></span>
                            </div>

                            <div class="card-body p-0 d-flex align-items-center justify-content-center bg-view" style="min-height: 500px;">
                                <t t-if="dms_file.mimetype and dms_file.mimetype.startswith('image/')">
                                    <img t-attf-src="/web/image/dms.file/#{dms_file.id}/content" class="img-fluid rounded" style="max-height: 700px; object-fit: contain;" loading="lazy" alt="File Preview"/>
                                </t>

                                <t t-elif="dms_file.mimetype == 'application/pdf'">
                                    <iframe t-attf-src="/web/static/lib/pdfjs/web/viewer.html?file=/web/content/dms.file/#{dms_file.id}/content" width="100%" height="700px" style="border: none;"/>
                                </t>

                                <t t-elif="dms_file.mimetype and dms_file.mimetype.startswith('text/')">
                                    <iframe t-attf-src="/web/content/dms.file/#{dms_file.id}/content"
                                            width="100%" height="500px" class="bg-white border-0 p-3"/>
                                </t>

                                <div t-else="" class="text-center py-5">
                                    <div t-attf-class="o_image_64_max mb-3" t-att-data-mimetype="dms_file.mimetype"/>
                                    <p class="text-muted">
                                        <t t-esc="dms_file.name"/><br/>
                                        <span class="small">Preview not available. Please download to view.</span>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="file_details mt-3">
                            <div class="file_name">
                                <strong class="text-secondary">File Name: </strong> 
                                <t t-esc="dms_file.name"/>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a role="button" t-attf-href="/my/dms/file/#{dms_file.id}/download" class="btn btn-primary px-4">
                                    <i class="fa fa-download me-1"/> Download
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="mt32">
                <h4>
                    <strong>Message and communication history</strong>
                </h4>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="dms_file"/>
                    <t t-set="token" t-value="dms_file.access_token"/>
                    <t t-set="pid" t-value="pid"/>
                    <t t-set="hash" t-value="hash"/>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_my_dms_directory" name="My DMS Directory">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Directory: <t t-esc="dms_directory.name"/>
                </h3>

                <div class="list-group mt-3">
                    <t t-foreach="sub_directories" t-as="sub">
                        <a t-attf-href="/my/dms/directory/#{sub.id}" class="list-group-item list-group-item-action">
                            <i class="fa fa-folder text-warning mr-2"/>
                            <span t-esc="sub.name"/>
                        </a>
                    </t>

                    <t t-foreach="files" t-as="f">
                        <a t-attf-href="/my/dms/file/#{f.id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-file-text-o text-primary mr-2"/>
                                <span t-esc="f.name"/>
                            </div>
                            <span class="badge badge-light border">
                                <t t-esc="f.extension"/>
                            </span>
                        </a>
                    </t>
                </div>

                <t t-if="not files and not sub_directories">
                    <p class="text-muted mt-3">This directory is empty.</p>
                </t>
            </div>
        </t>
    </template>

</odoo>