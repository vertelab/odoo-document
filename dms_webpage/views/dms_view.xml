<odoo>
    <data>

        <record id="view_dms_directory_form" model="ir.ui.view">
            <field name="name">dms_directory.publish_button.form</field>
            <field name="model">dms.directory</field>
            <field name="inherit_id" ref="dms.view_dms_directory_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="open_website_url" invisible="not is_published">
                        <i class="fa fa-globe fa-fw o_button_icon text-success"/>
                        <div class="o_stat_info">
                            <span class="o_stat_text">Published:</span>
                            <span class="o_stat_text">View directory</span>
                        </div>
                    </button>

                    <button class="oe_stat_button" type="object" name="open_website_url" invisible="is_published">
                        <i class="fa fa-globe fa-fw o_button_icon text-danger"/>
                        <div class="o_stat_info">
                            <span class="o_stat_text">Unpublished</span>
                        </div>
                    </button>

                </xpath>

                <xpath expr="//div[@name='button_box']" position="after">
                    <widget name="web_ribbon" title="Published" bg_color="bg-success" invisible="not is_published"/>
                </xpath>

                <field name="inherit_group_ids" position="after">
                    <field name="is_published"/>
                </field>
            </field>
        </record>
    </data>
</odoo>