<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Access mode: owner.
            save_type='file' on purpose: an owner-scoped access group is what
            grants access, and attachment storage would bypass it by
            inheriting the record's rights instead.
        -->
        <record id="hr_employee_dms_storage" model="dms.storage">
            <field name="name">Employee documents</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="save_type">file</field>
            <field name="inherit_access_from_parent_record">False</field>
            <!--
                No model_ids. dms_field rejects a non-attachment storage that
                declares model_ids while its root directory has no res_id, and
                a root directory never has one. The owner access mode resolves
                nothing from a model, so the field has no meaning here.
            -->
        </record>

        <record id="hr_employee_dms_directory" model="dms.directory">
            <field name="name">Employee documents</field>
            <field name="is_root_directory">True</field>
            <field name="storage_id" ref="hr_employee_dms_storage"/>
            <field name="res_model" eval="False"/>
        </record>

    </data>
</odoo>
