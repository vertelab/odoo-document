<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Access mode: inherit for both.
            save_type='attachment' + inherit_access_from_parent_record is what
            makes the directory inherit the record's own ir.rule. Both are
            required: dms.security.mixin hardcodes them.

            Two storages on purpose: a lesson's directory must sit under the
            lesson storage's root, not under its course's directory, or moving
            a lesson to another course would orphan its files.
        -->
        <record id="slide_channel_dms_storage" model="dms.storage">
            <field name="name">Course documents</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="save_type">attachment</field>
            <field name="inherit_access_from_parent_record">True</field>
            <field name="model_ids" eval="[(6, 0, [ref('website_slides.model_slide_channel')])]"/>
        </record>

        <record id="slide_channel_dms_directory" model="dms.directory">
            <field name="name">Course documents</field>
            <field name="is_root_directory">True</field>
            <field name="storage_id" ref="slide_channel_dms_storage"/>
            <field name="model_id" ref="website_slides.model_slide_channel"/>
        </record>

        <record id="slide_slide_dms_storage" model="dms.storage">
            <field name="name">Lesson documents</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="save_type">attachment</field>
            <field name="inherit_access_from_parent_record">True</field>
            <field name="model_ids" eval="[(6, 0, [ref('website_slides.model_slide_slide')])]"/>
        </record>

        <record id="slide_slide_dms_directory" model="dms.directory">
            <field name="name">Lesson documents</field>
            <field name="is_root_directory">True</field>
            <field name="storage_id" ref="slide_slide_dms_storage"/>
            <field name="model_id" ref="website_slides.model_slide_slide"/>
        </record>

    </data>
</odoo>
