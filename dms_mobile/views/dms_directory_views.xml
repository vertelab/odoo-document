<odoo>
    <record id="dms_directory_view_form_mobile" model="ir.ui.view">
        <field name="name">dms.directory.form.mobile</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Mobile">
                    <field name="mobile_target" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
