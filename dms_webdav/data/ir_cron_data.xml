<?xml version="1.0" encoding="utf-8" ?>
<!--
    Sweep abandoned chunked uploads.

    A chunked PUT buffers chunks in the temp directory until the last one
    arrives. A client that dies halfway leaves those files behind with
    nothing to reclaim them. This cron removes anything older than the
    cutoff (24h by default, overridable through the config parameter
    dms_webdav.chunk_max_age_hours).

    Hourly rather than daily: the files are small and the sweep is cheap,
    but a stuck upload should not linger for a day before anyone notices.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_cleanup_chunks" model="ir.cron">
            <field name="name">WebDAV: remove abandoned chunked uploads</field>
            <field name="model_id" ref="model_dms_webdav_chunk_cleanup" />
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_chunks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
