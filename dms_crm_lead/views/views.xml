<odoo>
  <data>
    <record id="edit_event_dms_file" model="ir.ui.view">
      <field name="name">crm.lead.form.dms</field>
      <field name="model">crm.lead</field>
      <field name="inherit_id" ref="crm.crm_lead_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
          <button class="oe_stat_button" name="action_open_dms_files" type="object" invisible="not dms_directory_id" icon="fa-file-text-o">
            <field string="Documents" name="doc_count" widget="statinfo"/>
          </button>
        </xpath>
      </field>
    </record>
  </data>
</odoo>