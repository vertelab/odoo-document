<odoo>
    <data>
        <record id="property_property_form_view_dms_file" model="ir.ui.view">
            <field name="name">property.property.form.dms</field>
            <field name="model">property.property</field>
            <field name="inherit_id" ref="property_mgmt.property_property_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button class="oe_stat_button" name="action_open_dms_files"
                            type="object" icon="fa-file-text-o"
                            invisible="not dms_directory_id">
                        <field string="Documents" name="doc_count" widget="statinfo"/>
                    </button>
                </xpath>
                <field name="name" position="after">
                    <field name="dms_directory_id" invisible="1"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
