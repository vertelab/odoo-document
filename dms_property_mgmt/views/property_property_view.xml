<odoo>
    <data>
        <record id="property_property_form_view_dms_file" model="ir.ui.view">
            <field name="name">property.property.form.dms</field>
            <field name="model">property.property</field>
            <field name="inherit_id" ref="property_mgmt.property_property_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//header//button[last()]" position="after">
                    <button name="create_parent_dir" string="Create Property Dir" type="object" class="btn btn-primary" invisible="has_property_parent_dir"/>
                </xpath>
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <button class="oe_stat_button" name="action_view_dms_directory" type="object" icon="fa-folder" invisible="not has_property_parent_dir">
                        <field string="Directories" name="directory_count" widget="statinfo"/>
                    </button>
                    <button class="oe_stat_button" name="action_view_dms_files" type="object" icon="fa-file-text-o" invisible="not has_property_parent_dir">
                        <field string="Documents" name="doc_count" widget="statinfo"/>
                    </button>
                </xpath>
                <field name="size" position="after">
                    <field name="has_property_parent_dir"/>
                </field>
            </field>
        </record>

    </data>
</odoo>