<odoo>
  <data>
    <record id="hr_job_dms" model="ir.ui.view">
      <field name="name">hr.job.form</field>
      <field name="model">hr.job</field>
      <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
      <field name="arch" type="xml">
        <xpath expr="//button[@name='action_open_attachments']" position="after">
          <button class="oe_stat_button" name="action_open_dms_files"
                  type="object" icon="fa-file-text-o"
                  invisible="not dms_directory_id">
            <field string="Documents" name="doc_count" widget="statinfo"/>
          </button>
        </xpath>
        <field name="name" position="after">
          <field name="dms_directory_id" invisible="1"/>
        </field>
      </field>
    </record>

    <record id="hr_applicant_dms" model="ir.ui.view">
      <field name="name">hr.applicant.form</field>
      <field name="model">hr.applicant</field>
      <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
          <button class="oe_stat_button" name="action_open_dms_files"
                  type="object" icon="fa-file-text-o"
                  invisible="not dms_directory_id">
            <field string="Documents" name="doc_count" widget="statinfo"/>
          </button>
        </xpath>
        <field name="partner_name" position="after">
          <field name="dms_directory_id" invisible="1"/>
        </field>
      </field>
    </record>
  </data>
</odoo>
