<odoo>

    <record id="dms_vault_member_wizard_view_form" model="ir.ui.view">
        <field name="name">dms.vault.member.wizard.form</field>
        <field name="model">dms.vault.member.wizard</field>
        <field name="arch" type="xml">
            <form string="Vault Membership">
                <group>
                    <field name="vault_id" readonly="1" />
                    <field name="mode" widget="radio" />
                    <field name="user_id" options="{'no_create': True}" />
                </group>
                <field name="note" class="text-muted" />
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
