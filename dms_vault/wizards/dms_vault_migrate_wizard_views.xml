<odoo>

    <record id="dms_vault_migrate_wizard_view_form" model="ir.ui.view">
        <field name="name">dms.vault.migrate.wizard.form</field>
        <field name="model">dms.vault.migrate.wizard</field>
        <field name="arch" type="xml">
            <form string="Migrate Files into Vault">
                <group>
                    <field name="vault_id" readonly="1" />
                    <field name="pending_count" />
                </group>
                <group>
                    <field
                        name="file_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                    />
                </group>
                <div class="alert alert-info" role="alert">
                    Moving a file into a vault directory does not encrypt it.
                    The bytes are re-written by the migration, which is the
                    only step that encrypts them.
                </div>
                <field name="result" invisible="not result" />
                <footer>
                    <button
                        name="action_migrate"
                        type="object"
                        string="Move and Encrypt"
                        class="btn-primary"
                    />
                    <button
                        name="action_verify"
                        type="object"
                        string="Verify Only"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
