<odoo>

    <!-- The losses are on the form, not only in the README: the person
         choosing an encrypted directory reads the form. -->
    <record id="dms_vault_view_form" model="ir.ui.view">
        <field name="name">dms.vault.form</field>
        <field name="model">dms.vault</field>
        <field name="arch" type="xml">
            <form string="Vault">
                <header>
                    <button
                        name="action_add_member"
                        type="object"
                        string="Add Member"
                        class="btn-primary"
                    />
                    <button
                        name="action_remove_member"
                        type="object"
                        string="Remove Member"
                    />
                    <button
                        name="action_migrate_files"
                        type="object"
                        string="Migrate Files"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="directory_id" />
                            <field name="storage_id" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="member_count" />
                            <field name="file_count" />
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>What is lost when a directory is a vault</strong>
                        <ul>
                            <li>No search. The text is never extracted.</li>
                            <li>No preview without decryption.</li>
                            <li>
                                No virus re-scanning after the fact. A file is
                                scanned once, before it is encrypted.
                            </li>
                            <li>
                                No recovery. Lose the master key and every
                                vault file is gone.
                            </li>
                            <li>
                                odoo.conf and the database must never share a
                                backup archive. Together they are the whole
                                secret.
                            </li>
                        </ul>
                    </div>
                    <notebook>
                        <page name="members" string="Members">
                            <field name="key_ids" readonly="1">
                                <list>
                                    <field name="user_id" />
                                    <field name="state" />
                                    <field name="revoked_date" />
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Revoking a member stops them from decrypting
                                anything they fetch from now on. It does not
                                re-encrypt the vault, and it does not take back
                                files they have already downloaded.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dms_vault_view_list" model="ir.ui.view">
        <field name="name">dms.vault.list</field>
        <field name="model">dms.vault</field>
        <field name="arch" type="xml">
            <list string="Vaults">
                <field name="name" />
                <field name="directory_id" />
                <field name="member_count" />
                <field name="file_count" />
            </list>
        </field>
    </record>

    <record id="dms_vault_action" model="ir.actions.act_window">
        <field name="name">Vaults</field>
        <field name="res_model">dms.vault</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
