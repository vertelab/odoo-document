<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Access mode: team.
            save_type='attachment' is fine here: the access group is set
            explicitly with inherit_group_ids=False, so the group decides and
            the parent record's rule is not consulted.
        -->
        <record id="helpdesk_team_dms_storage" model="dms.storage">
            <field name="name">Helpdesk team documents</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="save_type">attachment</field>
            <field name="inherit_access_from_parent_record">True</field>
            <field name="model_ids" eval="[(6, 0, [ref('helpdesk_mgmt.model_helpdesk_ticket_team')])]"/>
        </record>

        <record id="helpdesk_team_dms_directory" model="dms.directory">
            <field name="name">Helpdesk team documents</field>
            <field name="is_root_directory">True</field>
            <field name="storage_id" ref="helpdesk_team_dms_storage"/>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket_team"/>
        </record>

    </data>
</odoo>
