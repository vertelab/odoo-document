    <record id="slide_doc_s3_02_q1" model="slide.question">
        <field name="question">Vad gör WebDAV?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_doc_s3_02"/>
    </record>
    <record id="slide_doc_s3_02_q1_a1" model="slide.answer">
        <field name="text_value">Visar en webbtjänst som en disk på datorn</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Du arbetar med filerna som på vilken nätverksdisk som helst.</field>
        <field name="question_id" ref="slide_doc_s3_02_q1"/>
    </record>
    <record id="slide_doc_s3_02_q1_a2" model="slide.answer">
        <field name="text_value">Krypterar filerna</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — krypteringen sköts av anslutningen, inte av WebDAV i sig.</field>
        <field name="question_id" ref="slide_doc_s3_02_q1"/>
    </record>
    <record id="slide_doc_s3_02_q1_a3" model="slide.answer">
        <field name="text_value">Komprimerar filerna</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — komprimering är inte syftet.</field>
        <field name="question_id" ref="slide_doc_s3_02_q1"/>
    </record>

    <record id="slide_doc_s3_02_q2" model="slide.question">
        <field name="question">Varför är monteringen viktig för att systemet ska användas?</field>
        <field name="sequence">2</field>
        <field name="slide_id" ref="slide_doc_s3_02"/>
    </record>
    <record id="slide_doc_s3_02_q2_a1" model="slide.answer">
        <field name="text_value">Man slipper ladda upp filer manuellt i webbläsaren</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Ingen vill göra det varje gång — därför tappar system utan montering användare.</field>
        <field name="question_id" ref="slide_doc_s3_02_q2"/>
    </record>
    <record id="slide_doc_s3_02_q2_a2" model="slide.answer">
        <field name="text_value">Det går snabbare att söka</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — sökningen är densamma.</field>
        <field name="question_id" ref="slide_doc_s3_02_q2"/>
    </record>
    <record id="slide_doc_s3_02_q2_a3" model="slide.answer">
        <field name="text_value">Filerna blir säkrare</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — säkerheten är densamma. Det är arbetssättet som blir enklare.</field>
        <field name="question_id" ref="slide_doc_s3_02_q2"/>
    </record>

    <record id="slide_doc_s3_02_q3" model="slide.question">
        <field name="question">Vad bör du bocka i när du ansluter enheten i Windows?</field>
        <field name="sequence">3</field>
        <field name="slide_id" ref="slide_doc_s3_02"/>
    </record>
    <record id="slide_doc_s3_02_q3_a1" model="slide.answer">
        <field name="text_value">Återanslut vid inloggning</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Annars försvinner enheten vid omstart och du tror att något är fel.</field>
        <field name="question_id" ref="slide_doc_s3_02_q3"/>
    </record>
    <record id="slide_doc_s3_02_q3_a2" model="slide.answer">
        <field name="text_value">Skrivskyddad anslutning</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — då kan du inte spara något.</field>
        <field name="question_id" ref="slide_doc_s3_02_q3"/>
    </record>
    <record id="slide_doc_s3_02_q3_a3" model="slide.answer">
        <field name="text_value">Offline-läge</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — det är för lokala kopior, inte för nätverksdiskar.</field>
        <field name="question_id" ref="slide_doc_s3_02_q3"/>
    </record>

