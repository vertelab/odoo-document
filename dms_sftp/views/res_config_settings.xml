<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dms_sftp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dms.sftp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25" />
        <field name="inherit_id" ref="dms.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='dms']" position="inside">
                <block title="SFTP">
                    <setting
                        string="Bind Address"
                        help="Host and port for the SFTP server (e.g. localhost:2222)"
                    >
                        <field name="dms_sftp_bind" />
                    </setting>
                    <setting
                        string="Read-only"
                        help="If enabled, SFTP access is read-only"
                    >
                        <field name="dms_sftp_readonly" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
